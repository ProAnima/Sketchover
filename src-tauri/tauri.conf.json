{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sketchover",
  "version": "../package.json",
  "identifier": "studio.proanima.sketchover",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMzVGMERBQTAzNTY3RDQKUldUVVp6V2cydkExb1htSTNMeDd4NVhOSDErSlZRVDRyTHFYM2JCODlTazlsSEZuVjh0MHcwQVMK",
      "endpoints": [
        "https://hub.proanima.net/v1/sketchover/update/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/ProAnima/Sketchover/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "publisher": "ProAnimaStudio",
    "homepage": "https://github.com/ProAnima/Sketchover",
    "copyright": "Copyright (c) 2026 ProAnimaStudio",
    "category": "Productivity",
    "shortDescription": "Рисование поверх окон",
    "longDescription": "Sketchover — прозрачный холст поверх всех окон: кисть, стрелки, блоки с текстом, лазерная указка. Вызывается одним хоткеем во время созвона.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian", "Spanish", "French", "German", "PortugueseBR", "SimpChinese", "Japanese", "Korean", "Arabic"],
        "displayLanguageSelector": true
      }
    }
  }
}
